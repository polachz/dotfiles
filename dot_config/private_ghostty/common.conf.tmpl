# Shared across every profile and OS.
# JetBrainsMono Nerd Font (see jetbrains-mono-nerd-font in packages.yaml) —
# needed to render the starship Pastel Powerline prompt's segment glyphs.
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# fish is the primary target interactive shell for this dotfiles setup (see
# CONCEPT_ROADMAP.md §1 — "první reálný cíl"), but it isn't the account's
# login shell (that's left as zsh, macOS's system default, since chsh has
# wider effects than just this terminal — e.g. SSH sessions on this same
# machine). Setting it here instead makes Ghostty launch fish without
# touching the account-wide login shell. Not an absolute path — resolves via
# PATH, which on macOS includes Homebrew's bin dir via /etc/paths.d/homebrew
# (added by the Homebrew .pkg installer) even for GUI-launched apps.
command = fish
