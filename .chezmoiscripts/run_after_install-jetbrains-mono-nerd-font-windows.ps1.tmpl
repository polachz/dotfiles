{{- if and (eq .chezmoi.os "windows") (eq .deployment.role "workstation") .deployment.has_gui -}}
# Installs JetBrainsMono Nerd Font per-user on Windows, no elevation required
# for anyone - runs on every apply (plain `run_after_` prefix), no-ops once
# the installed version matches the latest available. Windows counterpart of
# the `jetbrains-mono-nerd-font` packages.yaml entry, which is `winget: skip`
# here on purpose.
#
# WHY not the winget package (DEVCOM.JetBrainsMonoNerdFont): its manifest is
# a WiX MSI with NO per-user Scope option at all (confirmed live 2026-08-19,
# checked the actual winget-pkgs manifest) - unlike git/Total Commander,
# which install unprivileged for a genuine Standard-User account (Inno
# Setup's PrivilegesRequired=none / winget's "highestAvailable" model only
# asks admin-GROUP-MEMBER accounts whether to use their admin rights - a
# real Standard User is never prompted at all, confirmed via git-for-
# windows/build-extra's own install.iss source and Inno Setup's documented
# behavior), this MSI would just fail outright without elevation. So this
# installs directly from the upstream ryanoasis/nerd-fonts GitHub release
# instead - the same upstream project Homebrew's cask (used for Ghostty on
# macOS) repackages - into the per-user font location that's existed since
# Windows 10 1809 (%LOCALAPPDATA%\Microsoft\Windows\Fonts +
# HKCU\...\CurrentVersion\Fonts), with no elevation prompt for anyone,
# admin or not.
#
# Uses the "...Mono" variant specifically ("JetBrainsMonoNerdFontMono-*"),
# NOT the plain "JetBrainsMonoNerdFont-*" that dot_config/private_ghostty/
# common.conf.tmpl uses on macOS/Linux (font-family = "JetBrainsMono Nerd
# Font") — found live 2026-08-19 that the plain variant's `post` table has
# isFixedPitch=0 (confirmed via its font metadata), so Windows Terminal's
# font picker filters it out entirely (its default list only shows fonts
# flagged monospace) and silently falls back instead of rendering it, even
# with the registry/files correctly in place — survived a full machine
# reboot, ruling out a font-cache-timing issue. The "...Mono" variant has
# isFixedPitch=1 and registers as family "JetBrainsMono Nerd Font Mono"
# (nameID 16) — that's what Windows Terminal's font.face now uses (see
# AppData/.../Fragments/dotfiles/profile.json.tmpl), accepting that it won't
# exactly match Ghostty's family name (same situation as the old DEVCOM
# build's Windows-specific "JetBrainsMono NF" — Windows just needs its own
# reference here regardless of source).

$ErrorActionPreference = "Stop"

$fontsDir = Join-Path $env:LOCALAPPDATA "Microsoft\Windows\Fonts"
$stateDir = Join-Path $env:LOCALAPPDATA "dotfiles"
$versionFile = Join-Path $stateDir "jetbrains-mono-nerd-font.version"

New-Item -ItemType Directory -Path $fontsDir -Force | Out-Null
New-Item -ItemType Directory -Path $stateDir -Force | Out-Null

$latestTag = (Invoke-RestMethod -Uri "https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest").tag_name
# Version marker suffix bumped whenever the install mechanics change in a
# way that needs existing installs to be redone (not just a new upstream
# release) - "-mono" for the isFixedPitch variant switch, "-mono2" added
# 2026-08-19 for the full-path-in-registry-value fix (see below) - so
# machines with an older, still-broken install correctly detect a change
# and re-run instead of no-op'ing on a matching tag.
$targetVersion = "$latestTag-mono2"

$installedVersion = $null
if (Test-Path $versionFile) {
    $installedVersion = Get-Content $versionFile -Raw
}

if ($installedVersion -eq $targetVersion) {
    Write-Host "OK: JetBrainsMono Nerd Font Mono already up to date ($latestTag)" -ForegroundColor Green
    return
}

Write-Host "-> Installing JetBrainsMono Nerd Font Mono $latestTag (per-user, no elevation)" -ForegroundColor Blue

Add-Type -Name FontInstall -Namespace DotfilesBootstrap -MemberDefinition @'
[DllImport("gdi32.dll", CharSet = CharSet.Auto)]
public static extern int AddFontResourceEx(string lpFileName, uint fl, IntPtr pdv);
[DllImport("gdi32.dll", CharSet = CharSet.Auto)]
public static extern int RemoveFontResourceEx(string lpFileName, uint fl, IntPtr pdv);
[DllImport("user32.dll", SetLastError = true, CharSet = CharSet.Auto)]
public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, UIntPtr wParam, IntPtr lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult);
'@

$FR_PRIVATE = 0x10
$HWND_BROADCAST = [IntPtr]0xffff
$WM_FONTCHANGE = 0x001D

# Clean up a previous run's non-monospace-flagged "JetBrainsMono Nerd Font
# <Style> (TrueType)" entries (no "Mono" in the label — that's how the old
# ones are told apart from the new "JetBrainsMono Nerd Font Mono <Style>"
# ones) - stale files/registrations, not just harmless leftovers, since
# leaving both around risks Windows Terminal picking the wrong one again.
$oldRegValues = Get-ItemProperty -Path "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts" -ErrorAction SilentlyContinue
if ($oldRegValues) {
    $oldRegValues.PSObject.Properties |
        Where-Object { $_.Name -match '^JetBrainsMono Nerd Font (?!Mono)' } |
        ForEach-Object {
            $oldFile = Join-Path $fontsDir $_.Value
            if (Test-Path $oldFile) {
                [DotfilesBootstrap.FontInstall]::RemoveFontResourceEx($oldFile, $FR_PRIVATE, [IntPtr]::Zero) | Out-Null
                Remove-Item $oldFile -Force -ErrorAction SilentlyContinue
            }
            Remove-ItemProperty -Path "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts" -Name $_.Name -Force -ErrorAction SilentlyContinue
        }
}

$zipUrl = "https://github.com/ryanoasis/nerd-fonts/releases/download/$latestTag/JetBrainsMono.zip"
$zipPath = Join-Path $env:TEMP "dotfiles-jetbrains-mono-nerd-font.zip"
$extractDir = Join-Path $env:TEMP "dotfiles-jetbrains-mono-nerd-font-extract"

Invoke-WebRequest -Uri $zipUrl -OutFile $zipPath
if (Test-Path $extractDir) { Remove-Item $extractDir -Recurse -Force }
Expand-Archive -Path $zipPath -DestinationPath $extractDir -Force

# Only the "...Mono-<Style>.ttf" variant - excludes the plain/"...Propo-*"
# variants (not monospace-flagged, see the file-level comment above) and
# "JetBrainsMonoNL..." (no-ligatures variant).
$fontFiles = Get-ChildItem $extractDir -Filter "*.ttf" | Where-Object { $_.Name -match '^JetBrainsMonoNerdFontMono-[A-Za-z]+\.ttf$' }
if (-not $fontFiles) {
    throw "No matching JetBrainsMonoNerdFontMono-*.ttf files found in $zipUrl - archive layout may have changed, check manually."
}

foreach ($file in $fontFiles) {
    $destPath = Join-Path $fontsDir $file.Name
    Copy-Item $file.FullName $destPath -Force

    # Registry value NAME is just a human-readable label for the Fonts
    # control panel / uninstall bookkeeping - the family/style apps actually
    # use comes from the font file's own name table, not this string. Only
    # needs to be unique per file and end in "(TrueType)" - "Mono" included
    # here too so the cleanup regex above can tell old vs new apart.
    #
    # Registry VALUE, in contrast, is NOT cosmetic and must be the FULL PATH
    # here, not just the bare filename - confirmed live 2026-08-19 (the real
    # cause of the font still not appearing anywhere, even after a full
    # reboot, despite the file/AddFontResourceEx/isFixedPitch fix all being
    # correct). Windows' per-machine font loader (HKLM) resolves a bare
    # filename relative to the well-known %WINDIR%\Fonts automatically, but
    # there's no equivalent implicit base directory for HKCU entries -
    # %LOCALAPPDATA%\...\Fonts isn't a "well-known root" the OS assumes, so
    # a bare filename there silently fails to resolve for any process other
    # than the one that called AddFontResourceEx itself (which is
    # session/process-scoped by definition, not the persistent registration
    # newly-started processes or a reboot use to reload it). A full path in
    # the value fixes this - verified live via WPF's own font enumeration
    # ([System.Windows.Media.Fonts]::SystemFontFamilies, closer to what
    # packaged/DirectWrite apps like Windows Terminal see than GDI+'s
    # InstalledFontCollection, which doesn't surface per-user fonts at all)
    # picking it up immediately in a brand new process, with no reboot
    # needed at all.
    $style = $file.BaseName -replace '^JetBrainsMonoNerdFontMono-?', ''
    if (-not $style) { $style = "Regular" }
    $styleSpaced = ($style -creplace '(?<!^)(?=[A-Z])', ' ')
    $regName = "JetBrainsMono Nerd Font Mono $styleSpaced (TrueType)"

    New-ItemProperty -Path "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts" -Name $regName -Value $destPath -PropertyType String -Force | Out-Null
    [DotfilesBootstrap.FontInstall]::AddFontResourceEx($destPath, $FR_PRIVATE, [IntPtr]::Zero) | Out-Null
}

# Lets already-running apps (if any) pick up the new font without a log-off -
# newly-started processes see it via the registry key/folder regardless.
$broadcastResult = [UIntPtr]::Zero
[DotfilesBootstrap.FontInstall]::SendMessageTimeout($HWND_BROADCAST, $WM_FONTCHANGE, [UIntPtr]::Zero, [IntPtr]::Zero, 0, 5000, [ref]$broadcastResult) | Out-Null

Remove-Item $zipPath -Force -ErrorAction SilentlyContinue
Remove-Item $extractDir -Recurse -Force -ErrorAction SilentlyContinue

Set-Content -Path $versionFile -Value $targetVersion -NoNewline

Write-Host "OK: JetBrainsMono Nerd Font Mono $latestTag installed ($($fontFiles.Count) files, per-user, no elevation)" -ForegroundColor Green
{{- end -}}
