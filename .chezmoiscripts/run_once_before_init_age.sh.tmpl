{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Profile-aware Age + EJSON key bootstrap (interactive).
#
# Each profile uses its own key set — a personal machine cannot decrypt
# work blobs and vice versa.
#
# Flow: chezmoi prompts on TTY for the Age passphrase. Operator pastes it
# from a password manager. The Age passphrase never touches disk — it only
# lives in the chezmoi process memory for the duration of the decrypt.

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above included library
true || source ../.chezmoitemplates/scripts-library

profile='{{ .deployment.profile }}'

log_task "Install Age tool if necessary"
{{- if not (includeTemplate "is-os-command-available" (list "age")) -}}
{{ template "install-os-package" (dict "package_manager" $.package_manager "package" "age") }}
{{- end }}

{{- /*
  git is only ensured here for workstation role - this script's own age/EJSON decrypt uses
  chezmoi's built-in `chezmoi age decrypt`/`chezmoi decrypt` subcommands (see below), never a
  real `git` binary. The only actual git-binary usage anywhere in this repo is
  run_onchange_after_user-settings.sh.tmpl's remote-to-SSH switch, a workstation-only concern
  (a server never pushes back to the dotfiles repo) - so a server role gets no forced git
  install here at all. chezmoi's own built-in git (go-git) already handles the initial clone
  with no external git needed regardless of role. Workstations still get git properly via
  packages.yaml's own `git` entry during the normal apply - this pre-emptive install only
  matters for the later remote-switch script, which runs before packages.yaml's git would
  otherwise land.
*/ -}}
{{- if eq .deployment.role "workstation" }}
log_task "Install Git tool if necessary"
{{- if not (includeTemplate "is-os-command-available" (list "git")) -}}
{{ template "install-os-package" (dict "package_manager" $.package_manager "package" "git") }}
{{- end }}
{{- end }}

ch_cfg_dir='{{ .chezmoi_config_dir }}'
age_recipient='{{ .crypt.age.age_recipient }}'
ekey_id='{{ .crypt.ejson.key_id }}'
keys_dir='{{ .crypt.keys_dir }}'
age_key_file='{{ .crypt.age.age_key_file }}'

age_blob='{{ joinPath .chezmoi.sourceDir "age_key_" }}'"${profile}.age"
ejson_blob='{{ joinPath .chezmoi.sourceDir "ejson_key_" }}'"${profile}.age"
ekey_file="${keys_dir}/${ekey_id}"
ch_tmp_cfg="${ch_cfg_dir}/tmp_cfg.toml"

log_task "Processing key files for profile '${profile}'"

mkdir -p "${keys_dir}" && chmod 700 "${keys_dir}"

if [ ! -f "${age_key_file}" ]; then
    log_task "Decrypting Age key for profile '${profile}'"
    # `chezmoi age decrypt --passphrase` needs a real controlling terminal to prompt
    # securely — in a context with none (non-interactive automation, an SSH exec
    # channel with no pty allocated, CI) it fails instantly with "could not open a
    # new TTY". Without this upfront check, the retry loop below would spin forever
    # at effectively zero cost per iteration — confirmed live (burned real CPU on a
    # lab VM in seconds until manually killed, same class of bug as the earlier
    # PowerShell `ping` self-recursion finding). Fail fast with a clear message
    # instead of silently maxing out a CPU core.
    if [ ! -t 0 ]; then
        error "No controlling terminal available to prompt for the ${profile} Age passphrase (stdin is not a tty). Run this interactively, e.g. via a real SSH session, not a non-interactive exec/automation context."
    fi
    log_info "Paste the ${profile} Age passphrase from your password manager when prompted."
    attempt=0
    max_attempts=10
    while [ ! -f "${age_key_file}" ]; do
        attempt=$((attempt + 1))
        if [ "${attempt}" -gt "${max_attempts}" ]; then
            error "Failed to decrypt ${age_blob} after ${max_attempts} attempts — giving up."
        fi
        {{ .chezmoi.executable }} age decrypt --passphrase --output "${age_key_file}" "${age_blob}" \
            || log_error "Decrypting ${age_blob} failed (attempt ${attempt}/${max_attempts}). Try again..."
    done
    chmod 600 "${age_key_file}"
fi

if [ ! -f "${ekey_file}" ]; then
    log_task "Decrypting EJSON key for profile '${profile}'"
    cat > "${ch_tmp_cfg}" <<EOF
encryption = 'age'
[age]
    identity = '${age_key_file}'
    recipient = '${age_recipient}'
EOF
    {{ .chezmoi.executable }} -c "${ch_tmp_cfg}" decrypt --output "${ekey_file}" "${ejson_blob}"
    rm -f "${ch_tmp_cfg}"
    chmod 600 "${ekey_file}"
fi
{{- end -}}
