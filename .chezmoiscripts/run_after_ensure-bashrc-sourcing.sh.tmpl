{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Ensures ~/.bashrc sources ~/.bashrc.d/* — idempotent, runs on every apply
# (plain `run_` prefix, not run_once_/run_onchange_) so it self-heals if
# ~/.bashrc is ever reset by an OS reinstall/package update.
#
# Fedora/RHEL ship this in their default ~/.bashrc, but it's NOT a safe
# cross-distro assumption — verified 2026-08-01: Ubuntu 24.04 LTS's default
# ~/.bashrc has no such thing, and even Ubuntu 25.10's brief attempt at this
# (bash 5.2.37-2ubuntu2) sourced a different, system-wide path
# (/etc/bash.bashrc.d, not ~/.bashrc.d) and was reverted again in 26.04.
# See docs/ARCHITECTURE.md §4 for the full finding.

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above included library
true || source ../.chezmoitemplates/scripts-library

bashrc="${HOME}/.bashrc"
touch "${bashrc}"

if ! grep -q '\.bashrc\.d' "${bashrc}"; then
    log_task "~/.bashrc doesn't source ~/.bashrc.d/ on this system — adding it"
    cat >> "${bashrc}" <<'EOF'

# Added by dotfiles bootstrap — not every distro's default ~/.bashrc sources
# ~/.bashrc.d/* the way Fedora's does (Ubuntu 24.04 LTS, for example, does
# not) — see docs/ARCHITECTURE.md §4.
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
EOF
fi

# Bash login shells read the first existing file in this order and stop:
# ~/.bash_profile, ~/.bash_login, ~/.profile. Keep those files user-owned and
# add only the bridge needed for interactive login shells to reach ~/.bashrc.
# Create ~/.bash_profile when none exists, so a new login bash has a
# deterministic, self-healing entry point.
login_rc=""
for candidate in "${HOME}/.bash_profile" "${HOME}/.bash_login" "${HOME}/.profile"; do
    if [ -f "${candidate}" ] && [ -r "${candidate}" ]; then
        login_rc="${candidate}"
        break
    fi
done
if [ -z "${login_rc}" ]; then
    login_rc="${HOME}/.bash_profile"
    touch "${login_rc}"
fi

if ! grep -Fq '# dotfiles bootstrap: load ~/.bashrc for interactive login shells' "${login_rc}" \
    && ! grep -Ev '^[[:space:]]*#' "${login_rc}" | grep -Eq '(^|[[:space:];])([.]|source)[[:space:]]+[^#]*\.bashrc([^[:alnum:]_]|$)'; then
    log_task "${login_rc} doesn't source ~/.bashrc for interactive login shells — adding it"
    cat >> "${login_rc}" <<'EOF'

# dotfiles bootstrap: load ~/.bashrc for interactive login shells
if [ -n "${BASH_VERSION:-}" ]; then
    case $- in
        *i*) [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc" ;;
    esac
fi
EOF
fi
{{- end -}}
