{{- if and (eq .chezmoi.os "windows") (eq .deployment.role "workstation") .deployment.has_gui (not .deployment.can_elevate) -}}
# Fallback-only: installs Total Commander per-user on Windows, no elevation
# required, for accounts that CAN'T elevate at all - runs on every apply
# (plain `run_after_` prefix), no-ops once the installed version matches
# the latest available. When this account CAN elevate, packages.yaml's own
# `totalcmd` entry (winget: Ghisler.TotalCommander, requires_elevation:
# true) handles it instead via the normal winget install - a real Program
# Files install with proper uninstaller registration, which this fallback
# deliberately doesn't attempt to replicate. Both are gated so exactly one
# ever runs (this one needs can_elevate false; the packages.yaml entry gets
# skipped when it's false - see run_onchange_install-packages.ps1.tmpl).
#
# WHY this fallback exists at all: Ghisler.TotalCommander's INSTALLER (an
# InstallShield self-extracting bootstrapper) forces elevation for EVERYONE
# via its own internal code, confirmed live 2026-08-19 - even though its
# own embedded
# manifest says requestedExecutionLevel="highestAvailable" (which should
# only ask admin-group members, per Inno Setup/manifest semantics - see
# bootstrap.ps1's git comment) and even with the __COMPAT_LAYER=RunAsInvoker
# compatibility shim, a genuine Standard User (confirmed via
# Get-LocalGroupMember -Group Administrators NOT listing the test account)
# still got a real credential-entry UAC prompt. The installer's elevation
# request is baked into its own application logic, not just the OS
# manifest, so no command-line trick can suppress it.
#
# THE ACTUAL PROGRAM needs none of that, though - confirmed live by
# extracting the installer's payload directly: TOTALCMD64.EXE has its OWN
# manifest with requestedExecutionLevel="asInvoker" (never self-elevates),
# and Total Commander is genuinely portable software - copy the files
# anywhere, no registry/system integration required to run it. The
# installer .exe is just a self-extracting ZIP (openable directly via
# .NET's ZipFile, no third-party tool needed) wrapping one INSTALL.CAB
# (a plain Microsoft Cabinet archive, extractable via Windows' own
# built-in expand.exe) containing the real program files. So this
# downloads the official installer .exe but NEVER RUNS it - only unpacks
# its payload with built-in Windows/.NET tools, entirely avoiding the
# installer's own forced-elevation code path.
#
# Version resolution: Ghisler's site has no GitHub-style releases API, so
# this scrapes the official download page for the current 64-bit installer
# URL (https://totalcommander.ch/<ver>/tcmd<ver>x64.exe) - more fragile
# than an API (breaks if Ghisler restructures the page), but stays current
# automatically rather than needing a manually-bumped pinned version
# (deliberate tradeoff, user's call 2026-08-19). Fails loudly, not
# silently, if the expected link pattern isn't found.

$ErrorActionPreference = "Stop"

$installDir = Join-Path $HOME "tcmd"
$stateDir = Join-Path $env:LOCALAPPDATA "dotfiles"
$versionFile = Join-Path $stateDir "totalcmd.version"

New-Item -ItemType Directory -Path $stateDir -Force | Out-Null

# Per-user Start Menu + Desktop shortcuts ($env:APPDATA / the per-user
# Desktop special folder, no elevation needed for either) - the all-users
# locations (%ProgramData%, the public Desktop) would need admin,
# deliberately not used here. A function, not inline, so it can run both
# on a fresh install AND on the "already up to date" no-op path below (an
# existing install from before shortcuts were added here shouldn't need a
# version bump just to get them - CreateShortcut is cheap/idempotent to
# just always re-ensure).
function New-TotalCommanderShortcuts($tcExe, $workDir) {
    $wshShell = New-Object -ComObject WScript.Shell
    $shortcutTargets = @(
        (Join-Path $env:APPDATA "Microsoft\Windows\Start Menu\Programs\Total Commander.lnk"),
        (Join-Path ([Environment]::GetFolderPath("Desktop")) "Total Commander.lnk")
    )
    foreach ($shortcutPath in $shortcutTargets) {
        $shortcut = $wshShell.CreateShortcut($shortcutPath)
        $shortcut.TargetPath = $tcExe
        $shortcut.WorkingDirectory = $workDir
        $shortcut.IconLocation = $tcExe
        $shortcut.Save()
    }
}

# A transient network failure (or, less likely than the GitHub-API-based
# tools above, a page-structure change) here is not worth aborting the
# WHOLE chezmoi apply over - this tool is optional, so it's skipped with a
# clear warning (retried next apply) instead, same pattern as the Nerd
# Font/7-Zip scripts.
try {
    $downloadPageHtml = (Invoke-WebRequest -Uri "https://www.ghisler.com/download.htm" -UseBasicParsing -ErrorAction Stop).Content
} catch {
    Write-Host "SKIP: could not reach https://www.ghisler.com/download.htm ($($_.Exception.Message)) - will retry next apply" -ForegroundColor Yellow
    return
}
$urlMatch = [regex]::Match($downloadPageHtml, 'https://totalcommander\.ch/(\d+)/tcmd\1x64\.exe')
if (-not $urlMatch.Success) {
    Write-Host "SKIP: could not find the Total Commander 64-bit download link on https://www.ghisler.com/download.htm - page structure may have changed, check manually" -ForegroundColor Yellow
    return
}
$downloadUrl = $urlMatch.Value
$latestVersion = $urlMatch.Groups[1].Value

$installedVersion = $null
if (Test-Path $versionFile) {
    $installedVersion = Get-Content $versionFile -Raw
}

if ($installedVersion -eq $latestVersion) {
    Write-Host "OK: Total Commander already up to date ($latestVersion)" -ForegroundColor Green
    $existingExe = Join-Path $installDir "TOTALCMD64.EXE"
    if (Test-Path $existingExe) {
        New-TotalCommanderShortcuts -tcExe $existingExe -workDir $installDir
    }
    return
}

Write-Host "-> Installing Total Commander $latestVersion (per-user, no elevation)" -ForegroundColor Blue

$exePath = Join-Path $env:TEMP "dotfiles-tcmd-installer.exe"
$zipPath = Join-Path $env:TEMP "dotfiles-tcmd-installer.zip"
$unpackDir = Join-Path $env:TEMP "dotfiles-tcmd-unpack"

Invoke-WebRequest -Uri $downloadUrl -OutFile $exePath
Copy-Item $exePath $zipPath -Force

if (Test-Path $unpackDir) { Remove-Item $unpackDir -Recurse -Force }
Add-Type -AssemblyName System.IO.Compression.FileSystem
[System.IO.Compression.ZipFile]::ExtractToDirectory($zipPath, $unpackDir)

$cabPath = Join-Path $unpackDir "INSTALL.CAB"
if (-not (Test-Path $cabPath)) {
    throw "INSTALL.CAB not found after unpacking $downloadUrl - installer layout may have changed, check manually."
}

New-Item -ItemType Directory -Path $installDir -Force | Out-Null
& expand.exe -F:* $cabPath $installDir | Out-Null
if ($LASTEXITCODE -ne 0) {
    throw "expand.exe failed extracting $cabPath (exit $LASTEXITCODE)."
}

$tcExe = Join-Path $installDir "TOTALCMD64.EXE"
if (-not (Test-Path $tcExe)) {
    throw "TOTALCMD64.EXE not found in $installDir after extraction - installer layout may have changed, check manually."
}

New-TotalCommanderShortcuts -tcExe $tcExe -workDir $installDir

Remove-Item $exePath -Force -ErrorAction SilentlyContinue
Remove-Item $zipPath -Force -ErrorAction SilentlyContinue
Remove-Item $unpackDir -Recurse -Force -ErrorAction SilentlyContinue

Set-Content -Path $versionFile -Value $latestVersion -NoNewline

Write-Host "OK: Total Commander $latestVersion installed to $installDir (per-user, no elevation, Start Menu shortcut created)" -ForegroundColor Green
{{- end -}}
