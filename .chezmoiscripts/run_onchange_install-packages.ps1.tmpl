{{- if eq .chezmoi.os "windows" -}}
# Per-profile/role package installation via winget. Re-runs whenever packages.yaml changes.
#
# Separate from run_onchange_install-packages.sh.tmpl (dnf/apt/brew, bash) — bash doesn't run
# natively on Windows and .sh scripts have no default chezmoi interpreter there (verified live
# 2026-08-07: a real `chezmoi apply` fails with "%1 is not a valid Win32 application" on any
# non-empty .sh.tmpl script). This file renders as nothing at all on non-Windows OSes (see the
# outer os guard wrapping the whole file) so chezmoi skips executing it there too — see
# CONCEPT_ROADMAP.md §7.

{{- /*
  No requires_elevation handling here (removed 2026-08-20) - any tool needing an
  if-can-elevate/else-portable-fallback decision gets its own dedicated run_after_ script
  instead (see run_after_install-totalcmd-windows.ps1.tmpl / run_after_install-7zip-windows.ps1.tmpl
  for the current examples), deciding the whole thing at chezmoi template render time. Splitting
  that decision from its outcome across this generic loop (a bare "SKIP" here) and a
  separately-timed script (the actual fallback, no visible link between the two log lines) was
  confusing - user's explicit feedback. Keep new elevation-sensitive Windows tools out of this
  loop for the same reason, not just totalcmd/7zip.
*/ -}}
{{- $role := .deployment.role }}
{{- $hasGui := .deployment.has_gui }}
{{- $vmType := .deployment.vm_type }}
{{- $profile := .deployment.profile }}
{{- $allTools := concat .packages.common (index .packages $profile) .packages.workstation_tools .packages.vm_guest_tools }}

$packages = @(
{{- range $allTools }}
  {{- $include := true }}
  {{- if hasKey . "roles" }}{{ if not (has $role .roles) }}{{ $include = false }}{{ end }}{{ end }}
  {{- if and $include (hasKey . "requires_gui") .requires_gui }}{{ if not $hasGui }}{{ $include = false }}{{ end }}{{ end }}
  {{- if and $include (hasKey . "vm_types") }}{{ if not (has $vmType .vm_types) }}{{ $include = false }}{{ end }}{{ end }}
  {{- if $include }}
    {{- $installCmd := includeTemplate "render-winget-install" . | trim }}
    {{- if ne $installCmd "skip" }}
      {{- $id := "" }}
      {{- if kindIs "map" .winget }}{{ $id = .winget.id }}{{ else }}{{ $id = .winget }}{{ end }}
    @{ Id = '{{ $id }}'; InstallCmd = '{{ $installCmd }}' }
    {{- end }}
  {{- end }}
{{- end }}
)

foreach ($pkg in $packages) {
    $installed = winget list --id $pkg.Id -e --source winget --accept-source-agreements 2>$null | Select-String -SimpleMatch $pkg.Id
    if ($installed) {
        Write-Host "OK: $($pkg.Id) already installed" -ForegroundColor Green
    } else {
        Write-Host "-> Installing $($pkg.Id)" -ForegroundColor Blue
        Invoke-Expression $pkg.InstallCmd
    }
}
{{- end -}}
