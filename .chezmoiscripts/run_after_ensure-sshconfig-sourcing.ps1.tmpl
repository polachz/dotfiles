{{- if eq .chezmoi.os "windows" -}}{{ "\ufeff" }}
# Ensures $HOME\.ssh\config includes ~/.ssh/conf.d/*.conf — idempotent, runs on
# every apply, matching run_after_ensure-sshconfig-sourcing.sh.tmpl.
#
# Historically this script embedded conf.d/*.conf inline between `# BEGIN dotfiles conf.d`
# / `# END dotfiles conf.d` markers due to an older Win32-OpenSSH Include hang bug.
# Verified live (2026-11-15) on both Win32-OpenSSH 9.5p2 (Windows 11 in-box) and
# 10.0p2 (GitHub release) that `Host *` + `Include ~/.ssh/conf.d/*.conf` works cleanly
# without hanging. If the legacy managed block is still present, this migrates it
# to `Include` automatically.

$sshDir = Join-Path $HOME ".ssh"
if (-not (Test-Path $sshDir)) {
    New-Item -ItemType Directory -Force -Path $sshDir | Out-Null
}

$sshConfig = Join-Path $sshDir "config"
if (-not (Test-Path $sshConfig)) {
    New-Item -ItemType File -Path $sshConfig -Force | Out-Null
}

$existingContent = Get-Content -Path $sshConfig -Raw -ErrorAction SilentlyContinue
if ($null -eq $existingContent) { $existingContent = "" }

$includeBlock = @"
# Added by dotfiles bootstrap — includes ~/.ssh/conf.d/*.conf
Host *
Include ~/.ssh/conf.d/*.conf
"@

$beginMarker = "# BEGIN dotfiles conf.d (managed by chezmoi, do not edit by hand)"
$endMarker = "# END dotfiles conf.d"
$beginIdx = $existingContent.IndexOf($beginMarker)

if ($beginIdx -ge 0) {
    $endIdx = $existingContent.IndexOf($endMarker, $beginIdx)
    if ($endIdx -ge 0) {
        $endIdx += $endMarker.Length
        $before = $existingContent.Substring(0, $beginIdx).TrimEnd("`r", "`n")
        $after = $existingContent.Substring($endIdx).TrimStart("`r", "`n")
        $parts = @()
        if ($before) { $parts += $before }
        if ($existingContent -notmatch '(?m)^Include ~/\.ssh/conf\.d/\*\.conf\s*$') {
            $parts += $includeBlock.TrimEnd()
        }
        if ($after) { $parts += $after }
        $updatedContent = ($parts -join "`n`n") + "`n"
        Set-Content -Path $sshConfig -Value $updatedContent -NoNewline
        Write-Host "`$HOME\.ssh\config migrated from inline conf.d block to Include" -ForegroundColor Blue
        return
    }
}

if ($existingContent -notmatch '(?m)^Include ~/\.ssh/conf\.d/\*\.conf\s*$') {
    Write-Host "`$HOME\.ssh\config doesn't include ~/.ssh/conf.d/ - adding it" -ForegroundColor Blue
    $prefix = if ($existingContent -and -not $existingContent.EndsWith("`n")) { "`n`n" } elseif ($existingContent) { "`n" } else { "" }
    Add-Content -Path $sshConfig -Value "$prefix$includeBlock" -NoNewline
}
{{- end -}}
