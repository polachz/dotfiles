{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Ensures ~/Devel exists — idempotent, runs on every apply (plain `run_`
# prefix). This is the source-code working directory the `d` alias
# (.chezmoidata/aliases/common/nav.yaml, docs/ARCHITECTURE.md §7) cd's into —
# ~/Devel is used on all platforms (see the .ps1.tmpl counterpart of
# this script for Windows).

mkdir -p "${HOME}/Devel"
{{- end -}}
