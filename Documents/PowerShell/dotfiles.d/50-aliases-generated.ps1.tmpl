{{- /*
  Rendered by chezmoi from .chezmoidata/aliases/*.yaml — do not edit this file
  directly, edit the source YAML instead (see CONCEPT_ROADMAP.md §3.2/§3.3).

  Every entry renders as a PowerShell function, never `Set-Alias` — Set-Alias
  can't bind fixed arguments, and nearly every entry is "command + baked-in
  flags". `@args` is auto-appended so extra typed arguments still pass
  through (a bash alias gets this for free since expansion is textual) —
  UNLESS the command already references `$args` itself (e.g. `makeme`/
  `makeroot`, which need it mid-expression inside a `Start-Process
  -ArgumentList`); auto-appending `@args` there too would double up.

  `pipes_stdin: true` prepends `$input |` — required for anything meant to
  filter piped content (grep/fgrep/egrep). NOT done unconditionally: verified
  live that piping an empty `$input` into e.g. `Get-ChildItem` (called with
  no upstream pipe) silently suppresses ALL output — a plain function body
  does not auto-forward pipeline input the way bash/zsh/fish do, and forcing
  it on for entries that don't expect it breaks them outright.

  `kind` is ignored here (like bash/zsh) — PowerShell has no fish-`abbr`
  expand-on-space equivalent (CONCEPT_ROADMAP.md §10, best-effort/deferred).

  PowerShell resolves a bare typed name as Alias > Function > Cmdlet — an
  ALIAS wins over a function of the same name, unlike bash/zsh/fish where a
  function/alias always wins over a PATH binary. Confirmed live 2026-08-20:
  `gcm` silently ran PowerShell's own built-in `Get-Command` alias instead
  of this file's `function gcm {...}` (git commit -m). `Remove-Item
  Alias:<name>` before each function definition clears any built-in of the
  same name so the function actually wins — a no-op (`-ErrorAction
  SilentlyContinue`) for the (common) case where no such built-in exists.
*/ -}}
{{- range $cat, $entries := .aliases.common.categories }}
# {{ $cat }}
{{- range $entries }}
{{- $cmd := includeTemplate "resolve-os-value" (dict "value" .command "os" $.chezmoi.os) | trim }}
{{- if ne $cmd "skip" }}
{{- $prefix := "" }}
{{- if hasKey . "pipes_stdin" }}{{- if .pipes_stdin }}{{ $prefix = "$input | " }}{{- end }}{{- end }}
if (Test-Path "Alias:{{ .name }}") { Remove-Item "Alias:{{ .name }}" -Force }
{{- if contains "$args" $cmd }}
function {{ .name }} { {{ $prefix }}{{ $cmd }} }  # {{ .description }}
{{- else }}
function {{ .name }} { {{ $prefix }}{{ $cmd }} @args }  # {{ .description }}
{{- end }}
{{- end }}
{{- end }}
{{ end -}}
