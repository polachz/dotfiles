{{- /* Decrypts one field out of a profile's EJSON evault at apply-time (first real use case */ -}}
{{- /* for the evault-secret-injection mechanism sketched in docs/ARCHITECTURE.md §7). */ -}}
{{- /* Expects a dict as input with keys "profile" (e.g. "work") and "path" — a dot-separated */ -}}
{{- /* key path into the decrypted JSON, e.g. "git.github_email". Returns the string value. */ -}}
{{- /* Requires the EJSON private key for that profile to already be unlocked at */ -}}
{{- /* .crypt.keys_dir (see run_once_before_init_age.sh.tmpl, a run_once_before_ script that */ -}}
{{- /* runs ahead of file application in the same apply) — fails loudly if missing rather than */ -}}
{{- /* silently rendering an empty value. */ -}}
{{- /* NOTE: takes .chezmoi.sourceDir and .crypt.keys_dir explicitly (not via $) because */ -}}
{{- /* includeTemplate re-roots $ to this dict, not the caller's top-level data. */ -}}
{{- $profile := .profile -}}
{{- $path := .path -}}
{{- $evaultFile := joinPath .sourceDir "secrets" $profile "evault" -}}
{{- $decrypted := output "ejson" "-keydir" .keysDir "decrypt" $evaultFile | fromJson -}}
{{- /* A missing key does NOT abort the apply: it prints a warning (warnf, stderr) and returns */ -}}
{{- /* an empty string, so callers must guard against "" (e.g. skip the config line). Fix it */ -}}
{{- /* with 'edit-evault <profile>' and re-run 'chezmoi apply'. A failing ejson decrypt itself */ -}}
{{- /* (ejson/key missing) is still a hard error - that is a broken setup, not a missing value. */ -}}
{{- $value := $decrypted -}}
{{- $missing := false -}}
{{- $walked := list -}}
{{- range splitList "." $path -}}
{{- if not $missing -}}
{{- $walked = append $walked . -}}
{{- if and (kindIs "map" $value) (hasKey $value .) -}}
{{- $value = index $value . -}}
{{- else -}}
{{- $missing = true -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if $missing -}}
{{- warnf "evault-field: %q has no key %q in the %s evault - using an empty value. Add it with 'edit-evault %s' and re-run 'chezmoi apply'." $path (last $walked) $profile $profile -}}
{{- else -}}
{{- $value -}}
{{- end -}}
