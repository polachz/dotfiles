# shellcheck shell=bash

set -euo pipefail

if [[ -n "${CHZ_DOTFILES_DEBUG:-}" ]]; then
  set -x
fi

function ensure_path_entry() {
  local entries=("$@")

  for entry in "${entries[@]}"; do
    if [[ ":${PATH}:" != *":${entry}:"* ]]; then
      export PATH="${entry}:${PATH}"
    fi
  done
}

function log_color() {
  local color_code="$1"
  shift

  printf "\033[${color_code}m%s\033[0m\n" "$*" >&2
}

function log_red() {
  log_color "0;31" "$@"
}

function log_blue() {
  log_color "0;34" "$@"
}

function log_green() {
  log_color "1;32" "$@"
}

function log_yellow() {
  log_color "1;33" "$@"
}

function log_brown() {
  log_color "0;33" "$@"
}

function log_task() {
  log_blue "🔃" "$@"
}

function log_manual_action() {
  log_red "⚠️" "$@"
}

function log_c() {
  log_yellow "👉" "$@"
}

function c() {
  log_c "$@"
  "$@"
}

function c_exec() {
  log_c "$@"
  exec "$@"
}

function log_error() {
  log_red "❌" "$@"
}

function log_info() {
  log_blue "ℹ️" "$@"
}

function log_ok() {
  log_green "✓" "$@"
}

function log_warn() {
  log_yellow "⚠" "$@"
}

function log_debug_force() {
    log_brown "🔎" "$@"
}

function log_debug() {
    if [ -n "${CHZ_DOTFILES_DEBUG}" ]; then
       log_brown "🔎" "$@"
    fi
}

function error() {
  log_error "$@"
  exit 1
}

function sudo() {
  local exec=false
  if [[ "$1" == "exec" ]]; then
    shift
    exec=true
  fi

  # shellcheck disable=SC2312
  if [[ "$(id -u)" -eq 0 ]]; then
    if [[ "${exec}" == true ]]; then
      exec "$@"
    else
      "$@"
    fi
  else
    if ! command sudo --non-interactive true 2>/dev/null; then
      log_manual_action "Root privileges are required, please enter your password below"
      command sudo --validate
    fi
    if [[ "${exec}" == true ]]; then
      exec sudo "$@"
    else
      command sudo "$@"
    fi
  fi
}

function is_dnf_package_installed() {
  local package="$1"

  # `dnf list installed <pkg>` is NOT reliable here — verified live on Fedora 44/dnf5
  # 2026-08-07: for a package that is NOT installed but exists in an enabled repo (e.g. a
  # freshly-COPR-enabled one), dnf5 prints "Available packages" instead of erroring and still
  # exits 0, so this used to silently report every not-yet-installed-but-available package as
  # already installed. `rpm -q` queries the local package DB directly, no repo metadata involved.
  rpm -q "${package}" > /dev/null 2>&1
}

function is_apt_package_installed() {
  local package="$1"

  apt list --quiet --quiet --installed "${package}" 2>/dev/null | grep --quiet .
}

function is_brew_package_installed() {
  local package="$1"

  # brew install auto-detects formula vs. cask (verified live), but the list/query
  # side doesn't: `brew list --versions` only finds formulae, `--cask` only casks.
  brew list --versions "${package}" > /dev/null 2>&1 || brew list --cask --versions "${package}" > /dev/null 2>&1
}

function not_during_test() {
  if [[ "${DOTFILES_TEST:-}" == true ]]; then
    log_info "Skipping '${*}' because we are in test mode"
  else
    "${@}"
  fi
}

# https://stackoverflow.com/a/53640320/12156188
function service_exists() {
  local n=$1
  if [[ $(systemctl list-units --all -t service --full --no-legend "${n}.service" | sed 's/^\s*//g' | cut -f1 -d' ') == ${n}.service ]]; then
    return 0
  else
    return 1
  fi
}

function append_missing_packages_to_list() {
  local manager="$1"
  shift
  local wanted_packages=("$@")

  # Empty-array-safe under `set -u` — "${arr[@]}" alone would be an unbound
  # variable reference when wanted_packages has zero elements.
  if [[ ${#wanted_packages[@]} -eq 0 ]]; then
    return 0
  fi

  for package in "${wanted_packages[@]}"; do
    # shellcheck disable=SC2310
    if ! "is_${manager}_package_installed" "${package}"; then
      missing_packages+=("${package}")
    fi
  done

}

# Finds the download URL of a specific asset (matched by grep pattern) in a
# GitHub project's latest release. For the *version number* of the latest
# release, use the .chezmoitemplates/get-github-latest-verson chezmoi
# template instead (resolved at apply-time via a redirect, no curl needed) —
# this function is only for locating a specific downloadable asset, e.g. for
# a GitHub-release package-manager fallback (see CONCEPT_ROADMAP.md §7).
function github_release_asset_url() {
  local user_and_repo="$1"
  local grep_search_pattern="$2"

  curl -s "https://api.github.com/repos/${user_and_repo}/releases/latest" \
    | grep "browser_download_url.*${grep_search_pattern}" \
    | cut -d : -f 2,3 \
    | tr -d '"'
}