{{/*
  Per-profile Age + EJSON public identifiers.
  PUBLIC INFO ONLY — these are recipient strings and EJSON key IDs, not secrets.
  Replace placeholders after generating new keys (see README §Encryption).
*/}}
{{- $enc_age_recipient_personal := "age1juyg6eeee33whe2ws6sgn99khmpmk487lxwp3zn4ju7knje66vpspq4whc" -}}
{{- $enc_age_recipient_work     := "age1w2pmlanuspzc4fnzu99q0enlw4xv9pk802r7m9hyuhug4fgs946scdazhn" -}}
{{- $enc_ejson_key_id_personal  := "42f3b8a03a245634684166fa5216585f2f3d51b99d20d43172c8c04a34e4fd67" -}}
{{- $enc_ejson_key_id_work      := "ee6199e72ef1df36fac21e84403b6c7463450b5a5f733a2b70502b60144aac5d" -}}

{{/*
  Init-time facts (profile, role, has_gui) resolve in this order:
  1. matching DOTFILES_* env var, if set and non-empty (scripted/automated init — CI, lab VMs)
  2. interactive promptStringOnce/promptBoolOnce fallback (human-driven machines), cached in the
     local, never-committed chezmoi config after the first answer.
*/}}

{{/* Profile (personal | work). */}}
{{- $profile := env "DOTFILES_PROFILE" -}}
{{- if eq $profile "" -}}
  {{- $profile = promptStringOnce . "deployment.profile" "Profile (personal/work)" "personal" -}}
{{- end -}}
{{- if and (ne $profile "personal") (ne $profile "work") -}}
  {{- fail (printf "Invalid profile %q — must be 'personal' or 'work'" $profile) -}}
{{- end -}}

{{/* Role is orthogonal to profile — same identity/keys, different package/config selection. */}}
{{- $role := env "DOTFILES_ROLE" -}}
{{- if eq $role "" -}}
  {{- $role = promptStringOnce . "deployment.role" "Role (workstation/server)" "workstation" -}}
{{- end -}}
{{- if and (ne $role "workstation") (ne $role "server") -}}
  {{- fail (printf "Invalid role %q — must be 'workstation' or 'server'" $role) -}}
{{- end -}}

{{/*
  GUI presence is orthogonal to role — a workstation can be headless. Gates GUI-only tools
  (Ghostty, Windows Terminal, Bitwarden desktop, the Nerd Font). Only asks interactively on
  Linux, where a headless machine is common (that's what --role server is for elsewhere too) —
  macOS/Windows default straight to true without a prompt, since a headless Mac/Windows box
  isn't a real scenario this project needs to ask about every run. DOTFILES_HAS_GUI still
  overrides on any OS, for the rare exception (e.g. a genuinely headless Mac build server).
*/}}
{{- $hasGuiEnv := env "DOTFILES_HAS_GUI" -}}
{{- $has_gui := false -}}
{{- if ne $hasGuiEnv "" -}}
  {{- if and (ne $hasGuiEnv "true") (ne $hasGuiEnv "false") -}}
    {{- fail (printf "Invalid DOTFILES_HAS_GUI %q — must be 'true' or 'false'" $hasGuiEnv) -}}
  {{- end -}}
  {{- $has_gui = eq $hasGuiEnv "true" -}}
{{- else if ne .chezmoi.os "linux" -}}
  {{- $has_gui = true -}}
{{- else -}}
  {{- $has_gui = promptBoolOnce . "deployment.has_gui" "Does this machine have a GUI" true -}}
{{- end -}}

{{/*
  Do you have sudo/root access on this machine at all? Cached like profile/role/has_gui above
  (promptBoolOnce, asked once at init, remembered in chezmoi.yaml) rather than re-checked live on
  every apply like Windows' can_elevate (see below) — confirmed live this matters: a real check
  can't distinguish "no root" from "root, but needs an interactive password" without actually
  prompting for one, and prompting on every single `chezmoi update` (not just the first apply) on
  a machine that genuinely has none is exactly the friction this avoids. Default true (assume
  root is available unless told otherwise) — bootstrap.sh's `--sudo`/`CHZ_HAS_ROOT` bridges to
  DOTFILES_HAS_ROOT the same way `--gui`/CHZ_HAS_GUI bridges to DOTFILES_HAS_GUI above.
*/}}
{{- $hasRootEnv := env "DOTFILES_HAS_ROOT" -}}
{{- $has_root := true -}}
{{- if ne $hasRootEnv "" -}}
  {{- if and (ne $hasRootEnv "true") (ne $hasRootEnv "false") -}}
    {{- fail (printf "Invalid DOTFILES_HAS_ROOT %q — must be 'true' or 'false'" $hasRootEnv) -}}
  {{- end -}}
  {{- $has_root = eq $hasRootEnv "true" -}}
{{- else -}}
  {{- $has_root = promptBoolOnce . "deployment.has_root" "Do you have sudo/root access on this machine" true -}}
{{- end -}}

{{/* Resolve per-profile crypto identifiers. */}}
{{- $enc_age_recipient := $enc_age_recipient_personal -}}
{{- $enc_ejson_key_id  := $enc_ejson_key_id_personal  -}}
{{- if eq $profile "work" -}}
  {{- $enc_age_recipient = $enc_age_recipient_work -}}
  {{- $enc_ejson_key_id  = $enc_ejson_key_id_work  -}}
{{- end -}}

{{- $ch_cfg_dir         := joinPath .chezmoi.homeDir ".config/chezmoi" -}}
{{- $enc_keys_dir       := joinPath $ch_cfg_dir "keys" -}}
{{- $enc_age_key_file   := joinPath $ch_cfg_dir (printf "age_%s.key" $profile) -}}

{{/*
  Auto-detect virtualisation host so guest tools can install themselves. Linux-only tool.

  systemd-detect-virt has an unusual exit-code convention: on bare metal (no virtualization
  detected at all) it still prints "none" to stdout, but exits 1, not 0 — confirmed live on a
  real bare-metal server, where chezmoi's `output` (which errors on any non-zero exit) aborted
  the ENTIRE template render before this was wrapped in `sh -c "... || true"`. Every VM/container
  case (the thing this variable actually gates on) exits 0 as expected; only the bare-metal "none"
  case needed this.
*/}}
{{- $virt_type := "none" -}}
{{- if lookPath "systemd-detect-virt" -}}
  {{- $virt_type = (output "sh" "-c" "systemd-detect-virt || true" | trim) -}}
{{- end -}}

{{/*
  Windows-only: can this account actually elevate via UAC at all? NOT the same as "is this
  process currently elevated" (WindowsPrincipal.IsInRole is unreliable for that check anyway —
  UAC's split token means a non-elevated admin's own token often reports false) — this queries
  real local-Administrators-group membership by well-known SID (S-1-5-32-544, not the localized
  group name, which differs on non-English Windows). Recomputed fresh every run, not
  prompted/cached, matching the virt-detection pattern above — it's live system state, not a
  deployment identity choice like profile/role/gui.

  WHY this matters: some Windows installers (e.g. Total Commander's winget package) hard-require
  elevation for EVERYONE, admin or not — confirmed live 2026-08-19, a genuine Standard User gets
  an actual credential-entry UAC prompt (not the simple "allow?" a local admin sees), which would
  hang a scripted bootstrap forever. Others (git, per PrivilegesRequired=none — see bootstrap.ps1)
  degrade gracefully for Standard Users and don't need this at all. Consumed directly (template
  render time, not packages.yaml) by run_after_install-totalcmd-windows.ps1.tmpl and
  run_after_install-7zip-windows.ps1.tmpl, each choosing between a winget-install branch and a
  portable no-elevation fallback branch — see those files for why (2026-08-20 consolidation, see
  CONCEPT_ROADMAP.md §7).
*/}}
{{- $can_elevate := true -}}
{{- if eq .chezmoi.os "windows" -}}
  {{- $canElevateCheck := "try { $g = Get-LocalGroup -SID 'S-1-5-32-544' -ErrorAction Stop; $m = Get-LocalGroupMember -Group $g -ErrorAction Stop; $me = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value; if ($m | Where-Object { $_.SID.Value -eq $me }) { Write-Output 'true' } else { Write-Output 'false' } } catch { Write-Output 'false' }" -}}
  {{- $can_elevate = eq (output "powershell" "-NoProfile" "-NonInteractive" "-Command" $canElevateCheck | trim) "true" -}}
{{- end -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
  {{- $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

data:
  chezmoi_config_dir: {{ $ch_cfg_dir | quote }}
  crypt:
    keys_dir: {{ $enc_keys_dir | quote }}
    age:
      age_recipient: {{ $enc_age_recipient | quote }}
      age_key_file: {{ $enc_age_key_file | quote }}
    ejson:
      key_id: {{ $enc_ejson_key_id | quote }}
  deployment:
    profile: {{ $profile | quote }}
    role: {{ $role | quote }}
    has_gui: {{ $has_gui }}
    has_root: {{ $has_root }}
    can_elevate: {{ $can_elevate }}
    osid: {{ $osid | quote }}
{{- if eq $virt_type "oracle" }}
    vm: true
    vm_type: virtualbox
{{- else if eq $virt_type "kvm" }}
    vm: true
    vm_type: qemu
{{- else if eq $virt_type "vmware" }}
    vm: true
    vm_type: vmware
{{- else }}
    vm: false
    vm_type: none
{{- end }}
{{/*
  Detected by actual binary presence (lookPath), not a hardcoded os-release "id" allowlist —
  confirmed live on a real RHEL server ("id": "rhel", dnf-based like Fedora but not in the old
  fedora/ubuntu/debian-only list): the missing entry left `package_manager` entirely absent from
  this map, which crashed run_onchange_install-packages.sh.tmpl with "map has no entry for key
  package_manager" the first time it read `.package_manager`. lookPath-based detection covers
  every dnf-based distro (RHEL, CentOS, Rocky, AlmaLinux, Fedora, ...) and every apt-based one
  (Debian, Ubuntu, Mint, ...) without needing to enumerate them. Falls back to "none" (that
  script already treats any manager other than dnf/apt/brew as "install nothing", same graceful
  default as vm_type above) rather than leaving the key missing.
*/}}
{{- if eq .chezmoi.os "darwin" }}
  package_manager: brew
{{- else if eq .chezmoi.os "windows" }}
  package_manager: winget
{{- else if lookPath "dnf" }}
  package_manager: dnf
{{- else if or (lookPath "apt-get") (lookPath "apt") }}
  package_manager: apt
{{- else }}
  package_manager: none
{{- end }}
  ejson_vault: {{ joinPath .chezmoi.sourceDir "secrets" $profile "evault" | quote }}
encryption: 'age'
age:
  identity: {{ $enc_age_key_file | quote }}
  recipient: {{ $enc_age_recipient | quote }}
ejson:
  keyDir: {{ $enc_keys_dir | quote }}
diff:
  exclude:
    - scripts
{{- if eq .chezmoi.os "windows" }}
{{/*
  Without this, `chezmoi cd` (the `chd` function/alias) falls back to an
  OS-specific default on Windows — confirmed live 2026-08-20: that's
  cmd.exe, not the user's actual shell (pwsh), landing you in a completely
  different shell with none of this repo's functions/aliases/prompt. `$SHELL`
  detection (chezmoi's other fallback) doesn't exist as a concept on Windows
  at all, unlike Linux/macOS where it already picks the right shell without
  this override.
*/}}
cd:
  command: pwsh
{{- end }}
