{{/*
  Per-profile Age + EJSON public identifiers.
  PUBLIC INFO ONLY — these are recipient strings and EJSON key IDs, not secrets.
  Replace placeholders after generating new keys (see README §Encryption).
*/}}
{{- $enc_age_recipient_personal := "age1juyg6eeee33whe2ws6sgn99khmpmk487lxwp3zn4ju7knje66vpspq4whc" -}}
{{- $enc_age_recipient_work     := "age1w2pmlanuspzc4fnzu99q0enlw4xv9pk802r7m9hyuhug4fgs946scdazhn" -}}
{{- $enc_ejson_key_id_personal  := "42f3b8a03a245634684166fa5216585f2f3d51b99d20d43172c8c04a34e4fd67" -}}
{{- $enc_ejson_key_id_work      := "ee6199e72ef1df36fac21e84403b6c7463450b5a5f733a2b70502b60144aac5d" -}}

{{/* Prompt for profile on first init (personal | work). */}}
{{- $profile := promptStringOnce . "deployment.profile" "Profile (personal/work)" "personal" -}}
{{- if and (ne $profile "personal") (ne $profile "work") -}}
  {{- fail (printf "Invalid profile %q — must be 'personal' or 'work'" $profile) -}}
{{- end -}}

{{/* Resolve per-profile crypto identifiers. */}}
{{- $enc_age_recipient := $enc_age_recipient_personal -}}
{{- $enc_ejson_key_id  := $enc_ejson_key_id_personal  -}}
{{- if eq $profile "work" -}}
  {{- $enc_age_recipient = $enc_age_recipient_work -}}
  {{- $enc_ejson_key_id  = $enc_ejson_key_id_work  -}}
{{- end -}}

{{- $ch_cfg_dir         := joinPath .chezmoi.homeDir ".config/chezmoi" -}}
{{- $enc_keys_dir       := joinPath $ch_cfg_dir "keys" -}}
{{- $enc_age_key_file   := joinPath $ch_cfg_dir (printf "age_%s.key" $profile) -}}

{{/* Auto-detect virtualisation host so guest tools can install themselves. */}}
{{- $virt_type := (output "systemd-detect-virt" | trim) -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
  {{- $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

data:
  chezmoi_config_dir: {{ $ch_cfg_dir | quote }}
  crypt:
    keys_dir: {{ $enc_keys_dir | quote }}
    age:
      age_recipient: {{ $enc_age_recipient | quote }}
      age_key_file: {{ $enc_age_key_file | quote }}
    ejson:
      key_id: {{ $enc_ejson_key_id | quote }}
  deployment:
    profile: {{ $profile | quote }}
    osid: {{ $osid | quote }}
{{- if eq $virt_type "oracle" }}
    vm: true
    vm_type: virtualbox
{{- else if eq $virt_type "kvm" }}
    vm: true
    vm_type: qemu
{{- else if eq $virt_type "vmware" }}
    vm: true
    vm_type: vmware
{{- else }}
    vm: false
    vm_type: none
{{- end }}
{{- if eq .chezmoi.osRelease.id "fedora" }}
  package_manager: dnf
{{- else if eq .chezmoi.osRelease.id "ubuntu" }}
  package_manager: apt
{{- else if eq .chezmoi.osRelease.id "debian" }}
  package_manager: apt
{{- end }}
  ejson_vault: {{ joinPath .chezmoi.sourceDir "secrets" $profile "evault" | quote }}
encryption: 'age'
age:
  identity: {{ $enc_age_key_file | quote }}
  recipient: {{ $enc_age_recipient | quote }}
ejson:
  keyDir: {{ $enc_keys_dir | quote }}
diff:
  exclude:
    - scripts
