#!/usr/bin/env bash
# Chezmoi shortcuts + profile context export.

# Export current profile so scripts can detect which dotfiles set they're running on.
export CHZ_DEPLOYMENT_PROFILE="personal"

# Invoke chezmoi (flush history first to avoid losing it during chezmoi-triggered shell restart)
alias ch='history -a && chezmoi'
# Switch to chezmoi source directory
alias chd='history -a && chezmoi cd'
