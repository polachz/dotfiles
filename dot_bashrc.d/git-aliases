#!/usr/bin/env bash
# Git shortcuts.
#
# Moved here from dot_bashrc.d/personal/ 2026-08-15 — plain git wrapper
# aliases apply equally to work machines, nothing personal-specific about
# them (see CONCEPT_ROADMAP.md §3.6).

alias g="git"
alias gcm='git commit -m'
alias gst='git status'
# Add modified and deleted files to stash
alias gam='git add -u'
# Add files to stash
alias ga='git add'
