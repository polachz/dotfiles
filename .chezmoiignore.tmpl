{{/*
  Per-profile masking — ensures only the active profile's files reach disk.

  Files for the OTHER profile (bashrc subdir, evault, encryption keys) are
  ignored, so a personal machine never has plaintext work secrets and vice
  versa. The encrypted blobs that DO end up on disk (the ones for the other
  profile via the public repo clone) can't be decrypted because the matching
  Age key isn't on the machine.
*/}}

{{ if ne .deployment.profile "personal" }}
.bashrc.d/personal
.zshrc.d/personal
secrets/personal
ejson_key_personal.age
age_key_personal.age
.ssh/conf.d/*-personal-*.conf
.config/git/personal
{{ end }}

{{ if ne .deployment.profile "work" }}
.bashrc.d/work
.zshrc.d/work
secrets/work
ejson_key_work.age
age_key_work.age
.ssh/conf.d/*-work-*.conf
.config/git/work
{{ end }}

{{/*
  Ghostty: GUI-only (no point on a headless dev machine) and Mac/Linux-only
  (no Windows build exists). Within the surviving profile subdir, only the
  fragment for the actual host OS is kept — see CONCEPT_ROADMAP.md §6.
*/}}
{{ if or (not .deployment.has_gui) (eq .chezmoi.os "windows") }}
.config/ghostty
{{ else }}
{{ if ne .deployment.profile "personal" }}
.config/ghostty/personal
{{ else if eq .chezmoi.os "darwin" }}
.config/ghostty/personal/linux.conf
{{ else if eq .chezmoi.os "linux" }}
.config/ghostty/personal/mac.conf
{{ end }}
{{ if ne .deployment.profile "work" }}
.config/ghostty/work
{{ else if eq .chezmoi.os "darwin" }}
.config/ghostty/work/linux.conf
{{ else if eq .chezmoi.os "linux" }}
.config/ghostty/work/mac.conf
{{ end }}
{{ end }}

{{/*
  PowerShell 7 config — Windows-only (see CONCEPT_ROADMAP.md §3.3). Ignoring
  the whole Documents dir (not just Documents/PowerShell) matters on macOS:
  ~/Documents is TCC-protected, and chezmoi would still try to mkdir/chmod the
  now-empty parent dir even with only the child ignored, tripping "operation
  not permitted" without ever needing real access to it.
*/}}
{{ if ne .chezmoi.os "windows" }}
Documents
{{ end }}

{{/*
  Windows Terminal fragment: GUI-only and Windows-only (same has_gui/OS gating as Ghostty above,
  see CONCEPT_ROADMAP.md §7).
*/}}
{{ if or (not .deployment.has_gui) (ne .chezmoi.os "windows") }}
AppData/Local/Microsoft/Windows Terminal
{{ end }}

# Repo docs / bootstrap / helpers are not part of the dotfiles set.
CONCEPT_ROADMAP.md
README.md
ENCRYPTION_SETUP.md
DAILY_WORKFLOW.md
ALIASES.md
